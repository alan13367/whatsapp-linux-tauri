{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Linux",
  "version": "0.1.0",
  "identifier": "io.github.alan13367.whatsapp-linux-tauri",
  "build": {
    "frontendDist": "https://web.whatsapp.com/"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WhatsApp Linux",
        "url": "https://web.whatsapp.com/",
        "create": false,
        "width": 1200,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "incognito": false,
        "dataDirectory": "io.github.alan13367.whatsapp-linux-tauri/webkit",
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "devtools": false
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "createUpdaterArtifacts": false,
    "category": "SocialNetworking",
    "shortDescription": "Unofficial WhatsApp Web wrapper for Arch Linux",
    "longDescription": "A lightweight, unofficial WhatsApp Web desktop wrapper built with Tauri and WebKitGTK for current Arch Linux systems.",
    "homepage": "https://github.com/alan13367/whatsapp-linux-tauri",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
